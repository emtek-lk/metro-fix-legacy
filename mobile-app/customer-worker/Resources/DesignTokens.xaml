<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Spacing -->
    <x:Double x:Key="Spacing2xs">2</x:Double>
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">20</x:Double>
    <x:Double x:Key="Spacing2xl">24</x:Double>
    <x:Double x:Key="Spacing3xl">32</x:Double>
    <x:Double x:Key="Spacing4xl">40</x:Double>

    <!-- Type -->
    <x:String x:Key="FontFamilyPrimary">OpenSansRegular</x:String>
    <x:String x:Key="FontFamilySemibold">OpenSansSemibold</x:String>
    <x:Double x:Key="FontSizeDisplay">34</x:Double>
    <x:Double x:Key="FontSizeH1">28</x:Double>
    <x:Double x:Key="FontSizeH2">22</x:Double>
    <x:Double x:Key="FontSizeH3">18</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">16</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeBodySmall">13</x:Double>
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeTiny">11</x:Double>
    <x:Double x:Key="FontSizeButton">15</x:Double>

    <!-- Shape -->
    <x:Double x:Key="RadiusSm">8</x:Double>
    <x:Double x:Key="RadiusMd">12</x:Double>
    <x:Double x:Key="RadiusLg">16</x:Double>
    <x:Double x:Key="RadiusXl">20</x:Double>
    <x:Double x:Key="Radius2xl">24</x:Double>

    <!-- Layout primitives -->
    <Thickness x:Key="PagePadding">20,18,20,28</Thickness>
    <Thickness x:Key="PagePaddingTight">18,16,18,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingLarge">18</Thickness>
    <Thickness x:Key="InputPadding">14,12</Thickness>
    <Thickness x:Key="ButtonPadding">16,12</Thickness>
    <Thickness x:Key="ButtonPaddingCompact">12,9</Thickness>

    <!-- Text styles -->
    <Style x:Key="StyleEyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorAccentLight}, Dark={StaticResource ColorAccentDark}}" />
    </Style>

    <Style x:Key="StylePageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeH1}" />
        <Setter Property="LineHeight" Value="1.08" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StylePageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextMutedLight}, Dark={StaticResource ColorTextMutedDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StyleSectionHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeH3}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
    </Style>

    <Style x:Key="StyleCardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StyleMutedText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextMutedLight}, Dark={StaticResource ColorTextMutedDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="StyleFieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}" />
    </Style>

    <Style x:Key="StyleCaption" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextMutedLight}, Dark={StaticResource ColorTextMutedDark}}" />
    </Style>

    <Style x:Key="StylePillLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
    </Style>

    <!-- Layout styles -->
    <Style x:Key="StylePageContainer" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="{StaticResource PagePadding}" />
        <Setter Property="Spacing" Value="{StaticResource SpacingLg}" />
    </Style>

    <Style x:Key="StylePageHeader" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="6" />
        <Setter Property="Margin" Value="0,2,0,4" />
    </Style>

    <Style x:Key="StyleCardBorder" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight}, Dark={StaticResource ColorBorderDefaultDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSurfaceLight}, Dark={StaticResource ColorBgSurfaceDark}}" />
    </Style>

    <Style x:Key="StyleElevatedCardBorder" TargetType="Border" BasedOn="{StaticResource StyleCardBorder}">
        <Setter Property="Padding" Value="{StaticResource CardPaddingLarge}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorBorderSubtleLight}, Dark={StaticResource ColorBorderDefaultDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSurfaceElevatedLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
    </Style>

    <Style x:Key="StyleMetricCard" TargetType="Border" BasedOn="{StaticResource StyleCardBorder}">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
    </Style>

    <Style x:Key="StyleFeatureCard" TargetType="Border" BasedOn="{StaticResource StyleCardBorder}">
        <Setter Property="Padding" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="120" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSurfaceElevatedLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
    </Style>

    <Style x:Key="StyleIconBadge" TargetType="Border">
        <Setter Property="WidthRequest" Value="38" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 13" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorAccentBgDark}}" />
    </Style>

    <Style x:Key="StyleSearchField" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorBorderSubtleLight}, Dark={StaticResource ColorBorderDefaultDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSurfaceLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
    </Style>

    <Style x:Key="StyleSoftPanel" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorBorderSubtleLight}, Dark={StaticResource ColorBorderSubtleDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSubtleLight}, Dark={StaticResource ColorBgSubtleDark}}" />
    </Style>

    <Style x:Key="StyleAccentPill" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorAccentBgDark}}" />
    </Style>

    <Style x:Key="StyleSuccessPill" TargetType="Border" BasedOn="{StaticResource StyleAccentPill}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorStatusSuccessBgLight}, Dark={StaticResource ColorStatusSuccessBgDark}}" />
    </Style>

    <Style x:Key="StyleWarningPill" TargetType="Border" BasedOn="{StaticResource StyleAccentPill}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorStatusWarningBgLight}, Dark={StaticResource ColorStatusWarningBgDark}}" />
    </Style>

    <Style x:Key="StyleInfoPill" TargetType="Border" BasedOn="{StaticResource StyleAccentPill}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorStatusInfoBgLight}, Dark={StaticResource ColorStatusInfoBgDark}}" />
    </Style>

    <Style x:Key="StyleActionChip" TargetType="Border" BasedOn="{StaticResource StyleSoftPanel}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSurfaceLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
    </Style>

    <Style x:Key="StyleStatusStrip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSubtleLight}, Dark={StaticResource ColorBgSubtleDark}}" />
    </Style>

    <Style x:Key="StyleSecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeButton}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSubtleLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
    </Style>

    <Style x:Key="StyleDangerButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeButton}" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorStatusErrorLight}, Dark=#D85F5F}" />
    </Style>

    <Style x:Key="StyleCompactButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPaddingCompact}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentLight}, Dark={StaticResource ColorAccentDark}}" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style x:Key="StyleIconButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="WidthRequest" Value="46" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="MinimumHeightRequest" Value="46" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSurfaceLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
    </Style>

    <Style x:Key="StyleBottomNavigation" TargetType="Border">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorBorderSubtleLight}, Dark={StaticResource ColorBorderDefaultDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24,24,0,0" />
        <Setter Property="Padding" Value="10,8,10,10" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBgSurfaceLight}, Dark={StaticResource ColorBgSurfaceDark}}" />
    </Style>

    <Style x:Key="StyleFloatingActionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilySemibold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="WidthRequest" Value="58" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="MinimumHeightRequest" Value="58" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentLight}, Dark={StaticResource ColorAccentDark}}" />
    </Style>
</ResourceDictionary>
