<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GTEK.FSM.MobileApp.Controls"
             x:Class="GTEK.FSM.MobileApp.Pages.Customer.ProfilePage"
             Title="Profile">
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Style="{StaticResource StylePageContainer}">
            <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                <Label Text="CUSTOMER" Style="{StaticResource StyleEyebrow}" />
                <Label Text="Profile" Style="{StaticResource StylePageTitle}" />
                <Label Text="Keep your contact details updated for dispatch and support communication."
                       Style="{StaticResource StylePageSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource StyleStatusStrip}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                    <Label Text="Profile completion" Style="{StaticResource StyleFieldLabel}" />
                    <Border Grid.Column="1" Style="{StaticResource StyleSuccessPill}">
                        <Label Text="82%"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="{StaticResource FontSizeTiny}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorStatusSuccessLight}, Dark={StaticResource ColorStatusSuccessDark}}" />
                    </Border>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="0.82" HeightRequest="5" />
                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="Add emergency contact and preferred access notes to speed up dispatch." Style="{StaticResource StyleCaption}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Contact Details" Style="{StaticResource StyleSectionHeader}" />

                    <Label Text="Full Name" Style="{StaticResource StyleFieldLabel}" />
                    <Entry x:Name="FullNameEntry" Placeholder="Enter full name" />

                    <Label Text="Phone" Style="{StaticResource StyleFieldLabel}" />
                    <Entry x:Name="PhoneEntry" Placeholder="Enter phone number" Keyboard="Telephone" />

                    <Label Text="Email" Style="{StaticResource StyleFieldLabel}" />
                    <Entry x:Name="EmailEntry" Placeholder="Enter email address" Keyboard="Email" />

                    <Label Text="Address" Style="{StaticResource StyleFieldLabel}" />
                    <Editor x:Name="AddressEditor"
                            Placeholder="Enter service address"
                            AutoSize="TextChanges"
                            HeightRequest="96" />

                    <Label Text="Preferred Contact" Style="{StaticResource StyleFieldLabel}" />
                    <Picker x:Name="PreferredContactPicker" Title="Select contact method" />

                    <Button Text="Save Profile"
                            Margin="0,8,0,0"
                            Clicked="OnSaveProfileClicked" />
                    <Label x:Name="SaveStatusLabel"
                           Style="{StaticResource StyleCaption}"
                           TextColor="{AppThemeBinding Light={StaticResource ColorStatusSuccessLight}, Dark={StaticResource ColorStatusSuccessDark}}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <controls:RoleBottomNavigationBar Grid.Row="1" Role="Customer" ActiveItem="Profile" />
    </Grid>
</ContentPage>
