<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GTEK.FSM.MobileApp.Controls"
             x:Class="GTEK.FSM.MobileApp.Pages.Customer.RequestsPage"
             Title="GTEK FSM">
    <Grid RowDefinitions="*,Auto">
    <RefreshView x:Name="RequestRefreshView"
                 Grid.Row="0"
                 Refreshing="OnRefreshRequestCenter">
        <ScrollView>
        <VerticalStackLayout Style="{StaticResource StylePageContainer}">
            <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                <Label Text="CUSTOMER" Style="{StaticResource StyleEyebrow}" />
                <Label Text="My Requests" Style="{StaticResource StylePageTitle}" />
                <Label Text="Create service requests, inspect details, and follow live progression."
                       Style="{StaticResource StylePageSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource StyleStatusStrip}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="3">
                        <Label x:Name="RequestSyncStatusLabel"
                               Text="Realtime status initializing"
                               Style="{StaticResource StyleFieldLabel}" />
                        <Label Text="Pull to refresh • updates appear automatically when dispatch changes status"
                               Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource StyleSuccessPill}" VerticalOptions="Center">
                        <Label x:Name="RequestSyncPillLabel"
                               Text="SYNC"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="{StaticResource FontSizeTiny}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorStatusSuccessLight}, Dark={StaticResource ColorStatusSuccessDark}}" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Create New Request" Style="{StaticResource StyleSectionHeader}" />

                    <Label Text="Category" Style="{StaticResource StyleFieldLabel}" />
                    <Picker x:Name="CategoryPicker"
                            Title="Select category"
                            ItemDisplayBinding="{Binding Name}" />

                    <Label Text="Details" Style="{StaticResource StyleFieldLabel}" />
                    <Editor x:Name="RequestDetailsEditor"
                            Placeholder="Describe the issue in at least 10 characters"
                            AutoSize="TextChanges"
                            MaxLength="150"
                            HeightRequest="108" />

                    <Label x:Name="CreateRequestFeedbackLabel"
                           Style="{StaticResource StyleCaption}"
                           TextColor="{AppThemeBinding Light={StaticResource ColorStatusErrorLight}, Dark={StaticResource ColorStatusErrorDark}}" />

                    <Button Text="Submit Request"
                            Clicked="OnSubmitRequestClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource StyleCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Active Requests" Style="{StaticResource StyleSectionHeader}" VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="≡"
                                Style="{StaticResource StyleCompactButton}"
                                MinimumWidthRequest="48"
                                Clicked="OnOpenRequestFiltersClicked" />
                    </Grid>
                    <Border Style="{StaticResource StyleSearchField}">
                        <SearchBar Placeholder="Search requests"
                                   HeightRequest="48" />
                    </Border>
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource StyleActionChip}">
                            <Label x:Name="ActiveRequestFilterLabel" Text="All requests" Style="{StaticResource StyleCaption}" />
                        </Border>
                        <Border Style="{StaticResource StyleActionChip}">
                            <Label Text="Sort: newest" Style="{StaticResource StyleCaption}" />
                        </Border>
                    </HorizontalStackLayout>
                    <CollectionView x:Name="RequestsCollectionView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnRequestSelectionChanged"
                                    HeightRequest="360">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StyleFeatureCard}" Margin="0,0,0,12" MinimumHeightRequest="0">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="Scale" Value="1.01" />
                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorAccentLight}, Dark={StaticResource ColorAccentDark}}" />
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource StyleCardTitle}"
                                               FontSize="{StaticResource FontSizeBodyLarge}" />
                                        <Border Grid.Column="1"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999"
                                                Padding="10,4"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorAccentBgDark}}">
                                            <Label Text="{Binding StatusLabel}"
                                                   TextColor="{Binding StatusColor}"
                                                   FontFamily="{StaticResource FontFamilySemibold}"
                                                   FontSize="{StaticResource FontSizeTiny}" />
                                        </Border>
                                        <Label Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Summary}"
                                               Style="{StaticResource StyleMutedText}" />
                                        <Label Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding EtaText}"
                                               Style="{StaticResource StyleCaption}" />
                                        <Button Grid.Row="3"
                                                Grid.ColumnSpan="2"
                                                Text="View Details"
                                                Style="{StaticResource StyleSecondaryButton}"
                                                Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Request Detail" Style="{StaticResource StyleSectionHeader}" />
                    <Label x:Name="SelectedRequestTitleLabel" Style="{StaticResource StyleCardTitle}" />
                    <Label x:Name="SelectedRequestDescriptionLabel" Style="{StaticResource StyleMutedText}" />

                    <Border Style="{StaticResource StyleSoftPanel}">
                        <VerticalStackLayout Spacing="6">
                            <Label x:Name="SelectedRequestMetaLabel" Style="{StaticResource StyleCaption}" />
                            <Label x:Name="SelectedRequestLifecycleLabel" Style="{StaticResource StyleFieldLabel}" />
                            <Label x:Name="SelectedRequestWorkerLabel" Style="{StaticResource StyleCaption}" />
                            <Label x:Name="SelectedRequestJobLabel" Style="{StaticResource StyleCaption}" />
                            <Label x:Name="SelectedRequestUpdatedLabel" Style="{StaticResource StyleCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource StyleCardBorder}" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="48,*" RowSpacing="4" ColumnSpacing="12">
                            <Border Style="{StaticResource StyleIconBadge}">
                                <Label Text="T" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{StaticResource FontFamilySemibold}" TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Technician" Style="{StaticResource StyleFieldLabel}" />
                                <Label x:Name="TechnicianTrustLabel" Text="Assigned technician details will appear after dispatch confirms the visit." Style="{StaticResource StyleMutedText}" />
                            </VerticalStackLayout>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Progress="0.62" HeightRequest="6" Margin="0,8,0,0" />
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="ETA confidence updates as the worker progresses through check-in and travel states." Style="{StaticResource StyleCaption}" />
                        </Grid>
                    </Border>

                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                        <Button Text="Escalate"
                                Style="{StaticResource StyleCompactButton}"
                                Clicked="OnEscalateRequestClicked" />
                        <Button Grid.Column="1"
                                Text="Refresh ETA"
                                Style="{StaticResource StyleCompactButton}"
                                Clicked="OnRefreshEtaClicked" />
                        <Button Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="Message Technician"
                                Style="{StaticResource StyleSecondaryButton}"
                                Clicked="OnMessageTechnicianClicked" />
                    </Grid>

                    <Label Text="Status Tracking" Style="{StaticResource StyleCardTitle}" Margin="0,4,0,0" />
                    <VerticalStackLayout x:Name="StatusTimelineLayout" Spacing="8" />

                    <Label Text="Activity Timeline" Style="{StaticResource StyleCardTitle}" Margin="0,8,0,0" />
                    <VerticalStackLayout x:Name="RequestTimelineLayout" Spacing="8" />

                    <Label Text="Approvals &amp; Attachments" Style="{StaticResource StyleCardTitle}" Margin="0,8,0,0" />
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                        <Border Style="{StaticResource StyleSoftPanel}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Quote Review" Style="{StaticResource StyleFieldLabel}" />
                                <Label Text="No pending quote selected" Style="{StaticResource StyleCaption}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StyleSoftPanel}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Attachments" Style="{StaticResource StyleFieldLabel}" />
                                <Label Text="Photos and invoices appear here" Style="{StaticResource StyleCaption}" />
                            </VerticalStackLayout>
                        </Border>
                        <Button Grid.Row="1"
                                Text="Approve"
                                Style="{StaticResource StyleCompactButton}"
                                Clicked="OnApproveSelectedQuoteClicked" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Text="Reject"
                                Style="{StaticResource StyleSecondaryButton}"
                                Clicked="OnRejectSelectedQuoteClicked" />
                    </Grid>

                    <Label Text="Service Feedback" Style="{StaticResource StyleCardTitle}" Margin="0,8,0,0" />
                    <Label x:Name="CustomerFeedbackHintLabel" Style="{StaticResource StyleMutedText}" />
                    <Picker x:Name="CustomerFeedbackTypePicker" Title="Select feedback category" />
                    <Picker x:Name="CustomerRatingPicker" Title="Select rating" />
                    <Editor x:Name="CustomerFeedbackCommentEditor"
                            Placeholder="Share what went well or what needs improvement"
                            AutoSize="TextChanges"
                            MaxLength="1000"
                            HeightRequest="100" />
                    <Button x:Name="SubmitCustomerFeedbackButton"
                            Text="Submit Feedback"
                            Clicked="OnSubmitCustomerFeedbackClicked" />
                    <Label x:Name="CustomerFeedbackStatusLabel" Style="{StaticResource StyleCaption}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
    <Button Grid.Row="0"
            Text="+"
            Style="{StaticResource StyleFloatingActionButton}"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,18,18"
            Clicked="OnCreateRequestFabClicked" />
    <controls:RoleBottomNavigationBar Grid.Row="1" Role="Customer" ActiveItem="Requests" />
    </Grid>
</ContentPage>
