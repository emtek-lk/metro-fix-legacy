<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GTEK.FSM.MobileApp.Controls"
             x:Class="GTEK.FSM.MobileApp.Pages.Customer.SettingsPage"
             Title="Settings">
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Style="{StaticResource StylePageContainer}">
            <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                <Label Text="CUSTOMER" Style="{StaticResource StyleEyebrow}" />
                <Label Text="Settings" Style="{StaticResource StylePageTitle}" />
                <Label Text="Core account actions are grouped clearly while advanced preferences remain out of the way."
                       Style="{StaticResource StylePageSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Account" Style="{StaticResource StyleSectionHeader}" />
                    <Label Text="Theme and additional preferences can layer into this surface without changing the mobile design system."
                           Style="{StaticResource StyleMutedText}" />
                    <Button Text="Log Out"
                            Style="{StaticResource StyleDangerButton}"
                            Margin="0,8,0,0"
                            Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <controls:RoleBottomNavigationBar Grid.Row="1" Role="Customer" ActiveItem="Profile" />
    </Grid>
</ContentPage>
