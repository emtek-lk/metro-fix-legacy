<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GTEK.FSM.MobileApp.Controls"
             x:Class="GTEK.FSM.MobileApp.Pages.Customer.NotificationsPage"
             Title="Notifications">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Style="{StaticResource StylePageContainer}">
                <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                    <Label Text="CUSTOMER" Style="{StaticResource StyleEyebrow}" />
                    <Label Text="Notification Center" Style="{StaticResource StylePageTitle}" />
                    <Label Text="Priority updates, approvals, technician movement, and service outcomes in one place."
                           Style="{StaticResource StylePageSubtitle}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <Border Style="{StaticResource StyleActionChip}">
                        <Label Text="Unread 2" Style="{StaticResource StyleCaption}" />
                    </Border>
                    <Border Style="{StaticResource StyleActionChip}">
                        <Label Text="Priority" Style="{StaticResource StyleCaption}" />
                    </Border>
                    <Border Style="{StaticResource StyleActionChip}">
                        <Label Text="Approvals" Style="{StaticResource StyleCaption}" />
                    </Border>
                </HorizontalStackLayout>

                <Border Style="{StaticResource StyleElevatedCardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Technician arriving soon" Style="{StaticResource StyleCardTitle}" />
                            <Border Grid.Column="1" Style="{StaticResource StyleWarningPill}">
                                <Label Text="HIGH"
                                       FontFamily="{StaticResource FontFamilySemibold}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorStatusWarningLight}, Dark={StaticResource ColorStatusWarningDark}}" />
                            </Border>
                        </Grid>
                        <Label Text="AC Cooling Issue visit window starts in 35 minutes." Style="{StaticResource StyleMutedText}" />
                        <Button Text="Track Request" Style="{StaticResource StyleCompactButton}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource StyleCardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Grouped Updates" Style="{StaticResource StyleSectionHeader}" />
                        <Border Style="{StaticResource StyleSoftPanel}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Quote approval generated for rooftop service" />
                                <Label Text="Worker assigned to Water Pressure Drop" />
                                <Label Text="Generator Inspection completed and ready for feedback" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <controls:RoleBottomNavigationBar Grid.Row="1" Role="Customer" ActiveItem="Notifications" />
    </Grid>
</ContentPage>
