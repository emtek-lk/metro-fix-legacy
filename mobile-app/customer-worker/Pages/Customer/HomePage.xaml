<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GTEK.FSM.MobileApp.Controls"
             x:Class="GTEK.FSM.MobileApp.Pages.Customer.HomePage"
             Title="GTEK FSM">
    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <VerticalStackLayout Style="{StaticResource StylePageContainer}">
            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="56,*,Auto" RowSpacing="4" ColumnSpacing="12">
                    <Border WidthRequest="56"
                            HeightRequest="56"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorAccentBgDark}}">
                        <Label Text="C"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="22"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Good day" Style="{StaticResource StyleCaption}" />
                        <Label Text="Customer Dashboard" Style="{StaticResource StyleSectionHeader}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" Style="{StaticResource StyleAccentPill}" VerticalOptions="Center">
                        <Label Text="LIVE" Style="{StaticResource StylePillLabel}" />
                    </Border>
                    <Label Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Text="Track service requests, active jobs, approvals, and account updates from one mobile workspace."
                           Style="{StaticResource StyleMutedText}"
                           Margin="0,10,0,0" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Style="{StaticResource StyleMetricCard}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Raised" Style="{StaticResource StyleCaption}" />
                        <Label Text="3" FontSize="26" FontFamily="{StaticResource FontFamilySemibold}" />
                        <Label Text="Open" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StyleMetricCard}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Jobs" Style="{StaticResource StyleCaption}" />
                        <Label Text="2" FontSize="26" FontFamily="{StaticResource FontFamilySemibold}" />
                        <Label Text="Active" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StyleMetricCard}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Pending" Style="{StaticResource StyleCaption}" />
                        <Label Text="1" FontSize="26" FontFamily="{StaticResource FontFamilySemibold}" />
                        <Label Text="Review" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource StyleStatusStrip}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Realtime sync active" Style="{StaticResource StyleFieldLabel}" />
                        <Label Text="Last update just now • 2 notifications unread" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource StyleSuccessPill}" VerticalOptions="Center">
                        <Label Text="ONLINE"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="{StaticResource FontSizeTiny}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorStatusSuccessLight}, Dark={StaticResource ColorStatusSuccessDark}}" />
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource StyleCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Needs Attention" Style="{StaticResource StyleSectionHeader}" />
                        <Border Grid.Column="1" Style="{StaticResource StyleWarningPill}">
                            <Label Text="ACTION"
                                   FontFamily="{StaticResource FontFamilySemibold}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorStatusWarningLight}, Dark={StaticResource ColorStatusWarningDark}}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource StyleSoftPanel}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Text="Quote awaiting approval" Style="{StaticResource StyleCardTitle}" />
                            <Label Grid.Column="1" Text="LKR 18,500" Style="{StaticResource StyleFieldLabel}" />
                            <Label Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="Rooftop AC compressor repair can start after confirmation."
                                   Style="{StaticResource StyleMutedText}" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Approve"
                                Style="{StaticResource StyleCompactButton}"
                                Clicked="OnApproveQuoteClicked" />
                        <Button Grid.Column="1"
                                Text="Ask Support"
                                Style="{StaticResource StyleSecondaryButton}"
                                Clicked="OnContactSupportClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource StyleCardBorder}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                    <Label Text="Service Momentum" Style="{StaticResource StyleSectionHeader}" />
                    <Border Grid.Column="1" Style="{StaticResource StyleSuccessPill}">
                        <Label Text="72%"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="{StaticResource FontSizeTiny}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorStatusSuccessLight}, Dark={StaticResource ColorStatusSuccessDark}}" />
                    </Border>
                    <ProgressBar Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Progress="0.72"
                                 HeightRequest="6" />
                    <Label Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Text="Next technician visit is queued after approval confirmation."
                           Style="{StaticResource StyleMutedText}" />
                </Grid>
            </Border>

            <Label Text="Quick Access" Style="{StaticResource StyleSectionHeader}" />

            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                <Border Style="{StaticResource StyleFeatureCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnViewRequestsClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource StyleIconBadge}">
                            <Label Text="R" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{StaticResource FontFamilySemibold}" TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                        </Border>
                        <Label Text="My Requests" Style="{StaticResource StyleCardTitle}" />
                        <Label Text="Create and track service requests" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StyleFeatureCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackActiveJobClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource StyleIconBadge}">
                            <Label Text="J" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{StaticResource FontFamilySemibold}" TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                        </Border>
                        <Label Text="Jobs" Style="{StaticResource StyleCardTitle}" />
                        <Label Text="View active service work" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StyleFeatureCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditProfileClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource StyleIconBadge}">
                            <Label Text="P" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{StaticResource FontFamilySemibold}" TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                        </Border>
                        <Label Text="Profile" Style="{StaticResource StyleCardTitle}" />
                        <Label Text="Manage contact details" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource StyleFeatureCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenSettingsClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource StyleIconBadge}">
                            <Label Text="S" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{StaticResource FontFamilySemibold}" TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                        </Border>
                        <Label Text="Settings" Style="{StaticResource StyleCardTitle}" />
                        <Label Text="Account and preferences" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource StyleFeatureCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotificationsClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource StyleIconBadge}">
                            <Label Text="N" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{StaticResource FontFamilySemibold}" TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                        </Border>
                        <Label Text="Notifications" Style="{StaticResource StyleCardTitle}" />
                        <Label Text="Service updates and alerts" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource StyleFeatureCard}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnApproveQuoteClicked" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Border Style="{StaticResource StyleIconBadge}">
                            <Label Text="A" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="{StaticResource FontFamilySemibold}" TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                        </Border>
                        <Label Text="Approvals" Style="{StaticResource StyleCardTitle}" />
                        <Label Text="Review quotes and decisions" Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource StyleCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Recent Activity" Style="{StaticResource StyleSectionHeader}" />
                    <Border Style="{StaticResource StyleSoftPanel}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="14:10 • Technician assigned to AC Cooling Issue" />
                            <Label Text="13:45 • Quote generated for rooftop unit service" />
                            <Label Text="09:20 • Water Pressure Drop moved to Assigned" />
                        </VerticalStackLayout>
                    </Border>
                    <Button Text="Contact Support"
                            Style="{StaticResource StyleSecondaryButton}"
                            Clicked="OnContactSupportClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <controls:RoleBottomNavigationBar Grid.Row="1" Role="Customer" ActiveItem="Home" />
    </Grid>
</ContentPage>
