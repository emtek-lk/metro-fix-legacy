<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GTEK.FSM.MobileApp.Pages.Worker.SettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource StylePageContainer}">
            <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                <Label Text="WORKER" Style="{StaticResource StyleEyebrow}" />
                <Label Text="Settings" Style="{StaticResource StylePageTitle}" />
                <Label Text="Account actions remain clear, high-contrast, and safe to use in the field."
                       Style="{StaticResource StylePageSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Account" Style="{StaticResource StyleSectionHeader}" />
                    <Label Text="Additional options can be added later without changing the shared surface and action patterns."
                           Style="{StaticResource StyleMutedText}" />
                    <Button Text="Log Out"
                            Style="{StaticResource StyleDangerButton}"
                            Margin="0,8,0,0"
                            Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
