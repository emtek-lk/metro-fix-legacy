<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GTEK.FSM.MobileApp.Controls"
             x:Class="GTEK.FSM.MobileApp.Pages.Worker.NotificationsPage"
             Title="Notifications">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Style="{StaticResource StylePageContainer}">
                <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                    <Label Text="WORKER" Style="{StaticResource StyleEyebrow}" />
                    <Label Text="Dispatch Alerts" Style="{StaticResource StylePageTitle}" />
                    <Label Text="Priority assignments, route updates, schedule changes, and offline sync notices."
                           Style="{StaticResource StylePageSubtitle}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <Border Style="{StaticResource StyleActionChip}">
                        <Label Text="Dispatch" Style="{StaticResource StyleCaption}" />
                    </Border>
                    <Border Style="{StaticResource StyleActionChip}">
                        <Label Text="Route" Style="{StaticResource StyleCaption}" />
                    </Border>
                    <Border Style="{StaticResource StyleActionChip}">
                        <Label Text="Sync" Style="{StaticResource StyleCaption}" />
                    </Border>
                </HorizontalStackLayout>

                <Border Style="{StaticResource StyleElevatedCardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="High-priority job assigned" Style="{StaticResource StyleCardTitle}" />
                            <Border Grid.Column="1" Style="{StaticResource StyleWarningPill}">
                                <Label Text="NOW"
                                       FontFamily="{StaticResource FontFamilySemibold}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorStatusWarningLight}, Dark={StaticResource ColorStatusWarningDark}}" />
                            </Border>
                        </Grid>
                        <Label Text="Rooftop AC Compressor Fault is ready for acceptance." Style="{StaticResource StyleMutedText}" />
                        <Button Text="Open Assignment" Style="{StaticResource StyleCompactButton}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <controls:RoleBottomNavigationBar Grid.Row="1" Role="Worker" ActiveItem="Notifications" />
    </Grid>
</ContentPage>
