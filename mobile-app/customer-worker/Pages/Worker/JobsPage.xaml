<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GTEK.FSM.MobileApp.Pages.Worker.JobsPage"
             Title="GTEK FSM">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource StylePageContainer}">
            <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                <Label Text="WORKER" Style="{StaticResource StyleEyebrow}" />
                <Label Text="Jobs Workspace" Style="{StaticResource StylePageTitle}" />
                <Label Text="Accept assignments, inspect job details, and publish field status updates."
                       Style="{StaticResource StylePageSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource StyleCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Assignment Queue" Style="{StaticResource StyleSectionHeader}" VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="≡"
                                Style="{StaticResource StyleCompactButton}"
                                MinimumWidthRequest="48"
                                Clicked="OnOpenJobFiltersClicked" />
                    </Grid>
                    <Border Style="{StaticResource StyleSearchField}">
                        <SearchBar Placeholder="Search jobs"
                                   HeightRequest="48" />
                    </Border>
                    <CollectionView x:Name="JobsCollectionView"
                                    SelectionMode="Single"
                                    SelectionChanged="OnJobSelectionChanged"
                                    HeightRequest="360">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StyleFeatureCard}" Margin="0,0,0,12" MinimumHeightRequest="0">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="Scale" Value="1.01" />
                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorAccentLight}, Dark={StaticResource ColorAccentDark}}" />
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorBgSurfaceElevatedDark}}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="10">
                                        <Label Text="{Binding Title}"
                                               Style="{StaticResource StyleCardTitle}"
                                               FontSize="{StaticResource FontSizeBodyLarge}" />
                                        <Border Grid.Column="1"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999"
                                                Padding="10,4"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorAccentBgDark}}">
                                            <Label Text="{Binding PriorityLabel}"
                                                   TextColor="{Binding PriorityColor}"
                                                   FontFamily="{StaticResource FontFamilySemibold}"
                                                   FontSize="{StaticResource FontSizeTiny}" />
                                        </Border>
                                        <Label Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Location}"
                                               Style="{StaticResource StyleMutedText}" />
                                        <Label Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding StatusLabel}"
                                               TextColor="{Binding StatusColor}"
                                               FontFamily="{StaticResource FontFamilySemibold}"
                                               FontSize="{StaticResource FontSizeCaption}" />
                                        <Button Grid.Row="3"
                                                Grid.ColumnSpan="2"
                                                Text="Open Job"
                                                Style="{StaticResource StyleSecondaryButton}"
                                                Margin="0,4,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Job Detail" Style="{StaticResource StyleSectionHeader}" />
                    <Label x:Name="SelectedJobTitleLabel" Style="{StaticResource StyleCardTitle}" />
                    <Label x:Name="SelectedJobDescriptionLabel" Style="{StaticResource StyleMutedText}" />
                    <Label x:Name="SelectedJobMetaLabel" Style="{StaticResource StyleCaption}" />

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
                        <Button x:Name="AcceptAssignmentButton"
                                Text="Accept Assignment"
                                Clicked="OnAcceptAssignmentClicked" />
                        <Button Grid.Column="1"
                                Text="Refresh Detail"
                                Style="{StaticResource StyleSecondaryButton}"
                                Clicked="OnRefreshDetailClicked" />
                        <Button Grid.Row="1"
                                Text="Start Work"
                                Style="{StaticResource StyleCompactButton}"
                                Clicked="OnStartWorkClicked" />
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Text="Place On Hold"
                                Style="{StaticResource StyleCompactButton}"
                                Clicked="OnPlaceOnHoldClicked" />
                        <Button Grid.Row="2"
                                Text="Complete"
                                Style="{StaticResource StyleCompactButton}"
                                Clicked="OnCompleteRequestClicked" />
                        <Button Grid.Row="2"
                                Grid.Column="1"
                                Text="Resume Work"
                                Style="{StaticResource StyleSecondaryButton}"
                                Clicked="OnResumeWorkClicked" />
                    </Grid>

                    <Border Style="{StaticResource StyleSoftPanel}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Status Update" Style="{StaticResource StyleCardTitle}" />
                            <Picker x:Name="StatusPicker" Title="Select request status" />
                            <Button Text="Publish Request Status" Clicked="OnPublishStatusClicked" />
                            <Label x:Name="StatusResultLabel" Style="{StaticResource StyleCaption}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Worker Feedback" Style="{StaticResource StyleCardTitle}" />
                    <Label x:Name="WorkerFeedbackHintLabel" Style="{StaticResource StyleMutedText}" />
                    <Picker x:Name="WorkerFeedbackTypePicker" Title="Select feedback category" />
                    <Picker x:Name="WorkerRatingPicker" Title="Select rating" />
                    <Editor x:Name="WorkerFeedbackCommentEditor"
                            Placeholder="Describe blockers, quality observations, or follow-up issues"
                            AutoSize="TextChanges"
                            MaxLength="1000"
                            HeightRequest="100" />
                    <Button x:Name="SubmitWorkerFeedbackButton"
                            Text="Submit Worker Feedback"
                            Clicked="OnSubmitWorkerFeedbackClicked" />
                    <Label x:Name="WorkerFeedbackStatusLabel" Style="{StaticResource StyleCaption}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
