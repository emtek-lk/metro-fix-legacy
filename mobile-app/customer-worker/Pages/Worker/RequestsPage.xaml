<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GTEK.FSM.MobileApp.Pages.Worker.RequestsPage"
             Title="Requests">
    <ScrollView>
        <VerticalStackLayout Style="{StaticResource StylePageContainer}">
            <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                <Label Text="WORKER" Style="{StaticResource StyleEyebrow}" />
                <Label Text="Requests" Style="{StaticResource StylePageTitle}" />
                <Label Text="Worker request lists will share the same mobile-first cards and muted operational surfaces."
                       Style="{StaticResource StylePageSubtitle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Border Style="{StaticResource StyleAccentPill}" HorizontalOptions="Start">
                        <Label Text="COMING SOON" Style="{StaticResource StylePillLabel}" />
                    </Border>
                    <Label Text="Request queue" Style="{StaticResource StyleSectionHeader}" />
                    <Label Text="No workflow has been removed; this view keeps the visual structure ready for future request queue content."
                           Style="{StaticResource StyleMutedText}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
