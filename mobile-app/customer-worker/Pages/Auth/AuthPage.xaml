<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GTEK.FSM.MobileApp.Pages.Auth.AuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign In">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource StylePageContainer}" Spacing="20">
            <Grid ColumnDefinitions="*,48" ColumnSpacing="12">
                <VerticalStackLayout Style="{StaticResource StylePageHeader}">
                    <Label Text="GTEK FSM" Style="{StaticResource StyleEyebrow}" />
                    <Label Text="Local access" Style="{StaticResource StylePageTitle}" />
                    <Label Text="Sign in with a demo account or register a customer account in the baseline tenant."
                           Style="{StaticResource StylePageSubtitle}" />
                    <Label x:Name="ApiTargetLabel" Style="{StaticResource StyleCaption}" />
                </VerticalStackLayout>
                <Button x:Name="ThemeIconButton"
                        Grid.Column="1"
                        Text="☾"
                        Style="{StaticResource StyleIconButton}"
                        Clicked="OnToggleThemeClicked" />
            </Grid>

            <Border Style="{StaticResource StyleSoftPanel}" Padding="4">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                    <Button x:Name="LoginModeButton"
                            Text="Login"
                            Clicked="OnLoginModeClicked" />
                    <Button x:Name="RegisterModeButton"
                            Grid.Column="1"
                            Text="Register"
                            Clicked="OnRegisterModeClicked" />
                </Grid>
            </Border>

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   FontSize="{StaticResource FontSizeBodySmall}"
                   TextColor="{AppThemeBinding Light={StaticResource ColorStatusErrorLight}, Dark={StaticResource ColorStatusErrorDark}}" />

            <Border Style="{StaticResource StyleElevatedCardBorder}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout x:Name="RegisterFieldsLayout" IsVisible="False" Spacing="8">
                        <Label Text="Display Name" Style="{StaticResource StyleFieldLabel}" />
                        <Entry x:Name="DisplayNameEntry" Placeholder="Customer name" />

                        <Label Text="Tenant Code" Style="{StaticResource StyleFieldLabel}" Margin="0,4,0,0" />
                        <Entry x:Name="TenantCodeEntry" Placeholder="REF-BASELINE" Text="REF-BASELINE" />
                    </VerticalStackLayout>

                    <Label Text="Email" Style="{StaticResource StyleFieldLabel}" />
                    <Entry x:Name="EmailEntry" Keyboard="Email" Placeholder="name@example.com" />

                    <Label Text="Password" Style="{StaticResource StyleFieldLabel}" Margin="0,4,0,0" />
                    <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="Password" />

                    <Button x:Name="SubmitButton"
                            Text="Sign In"
                            Margin="0,8,0,0"
                            Clicked="OnSubmitClicked" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource StyleCardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Demo accounts" Style="{StaticResource StyleCardTitle}" />
                    <Label Text="customer@gtek.local / Customer@123" Style="{StaticResource StyleCaption}" />
                    <Label Text="worker@gtek.local / Worker@123" Style="{StaticResource StyleCaption}" />
                    <Label Text="support@gtek.local / Support@123" Style="{StaticResource StyleCaption}" />
                    <Label Text="shamilsuraweera@gmail.com / Admin@123" Style="{StaticResource StyleCaption}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
