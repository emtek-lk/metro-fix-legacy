<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GTEK.FSM.MobileApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customer="clr-namespace:GTEK.FSM.MobileApp.Pages.Customer"
    xmlns:worker="clr-namespace:GTEK.FSM.MobileApp.Pages.Worker"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutWidth="300"
    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBgPageLight}, Dark={StaticResource ColorBgPageDark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource ColorBgSurfaceLight}, Dark={StaticResource ColorBgSurfaceDark}}"
    Shell.NavBarHasShadow="False"
    Title="GTEK FSM">

    <Shell.ToolbarItems>
        <ToolbarItem x:Name="ThemeToolbarItem"
                     Text="☾"
                     Clicked="OnToggleThemeClicked" />
    </Shell.ToolbarItems>

    <Shell.FlyoutHeader>
        <Border Padding="20,24,20,18"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorBgSubtleLight}, Dark={StaticResource ColorBgSubtleDark}}">
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ColorAccentBgLight}, Dark={StaticResource ColorAccentBgDark}}">
                        <Label Text="G"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource ColorAccentTextLight}, Dark={StaticResource ColorAccentTextDark}}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="GTEK FSM"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="{StaticResource FontSizeH3}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimaryDark}}" />
                        <Label Text="Field service mobile"
                               Style="{StaticResource StyleCaption}" />
                    </VerticalStackLayout>
                </Grid>
                <Border Style="{StaticResource StyleCardBorder}" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Safry Workspace" Style="{StaticResource StyleFieldLabel}" />
                                <Label Text="Profile readiness and role tools" Style="{StaticResource StyleCaption}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource StyleSuccessPill}" VerticalOptions="Center">
                                <Label x:Name="RoleBadgeLabel"
                                       Text="CUSTOMER"
                                       FontFamily="{StaticResource FontFamilySemibold}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorStatusSuccessLight}, Dark={StaticResource ColorStatusSuccessDark}}" />
                            </Border>
                        </Grid>
                        <ProgressBar Progress="0.82" HeightRequest="5" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Workspace" Style="{StaticResource StyleFieldLabel}" />
                    <Border x:Name="RoleSwitchPanel"
                            Style="{StaticResource StyleSoftPanel}"
                            Padding="4">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Button x:Name="CustomerRoleButton"
                                    Text="Customer"
                                    Style="{StaticResource StyleCompactButton}"
                                    Clicked="OnCustomerRoleClicked" />
                            <Button x:Name="WorkerRoleButton"
                                    Grid.Column="1"
                                    Text="Worker"
                                    Style="{StaticResource StyleSecondaryButton}"
                                    Clicked="OnWorkerRoleClicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <FlyoutItem x:Name="CustomerHomeItem" Title="Customer Home" Route="CustomerHome">
        <ShellContent ContentTemplate="{DataTemplate customer:HomePage}" Route="CustomerHomeContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="CustomerRequestsItem" Title="Customer Requests" Route="CustomerRequests">
        <ShellContent ContentTemplate="{DataTemplate customer:RequestsPage}" Route="CustomerRequestsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="CustomerJobsItem" Title="Customer Jobs" Route="CustomerJobs">
        <ShellContent ContentTemplate="{DataTemplate customer:JobsPage}" Route="CustomerJobsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="CustomerApprovalsItem" Title="Approvals" Route="CustomerApprovals">
        <ShellContent ContentTemplate="{DataTemplate customer:RequestsPage}" Route="CustomerApprovalsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="CustomerNotificationsItem" Title="Notifications" Route="CustomerNotifications">
        <ShellContent ContentTemplate="{DataTemplate customer:NotificationsPage}" Route="CustomerNotificationsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="CustomerProfileItem" Title="Customer Profile" Route="CustomerProfile">
        <ShellContent ContentTemplate="{DataTemplate customer:ProfilePage}" Route="CustomerProfileContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="CustomerSettingsItem" Title="Customer Settings" Route="CustomerSettings">
        <ShellContent ContentTemplate="{DataTemplate customer:SettingsPage}" Route="CustomerSettingsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="CustomerSupportItem" Title="Support" Route="CustomerSupport">
        <ShellContent ContentTemplate="{DataTemplate customer:SettingsPage}" Route="CustomerSupportContent" />
    </FlyoutItem>

    <FlyoutItem x:Name="WorkerHomeItem" Title="Worker Home" Route="WorkerHome">
        <ShellContent ContentTemplate="{DataTemplate worker:HomePage}" Route="WorkerHomeContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="WorkerJobsItem" Title="Assigned Jobs" Route="WorkerJobs">
        <ShellContent ContentTemplate="{DataTemplate worker:JobsPage}" Route="WorkerJobsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="WorkerRequestsItem" Title="Worker Requests" Route="WorkerRequests">
        <ShellContent ContentTemplate="{DataTemplate worker:RequestsPage}" Route="WorkerRequestsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="WorkerScheduleItem" Title="Schedule" Route="WorkerSchedule">
        <ShellContent ContentTemplate="{DataTemplate worker:SchedulePage}" Route="WorkerScheduleContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="WorkerNotificationsItem" Title="Notifications" Route="WorkerNotifications">
        <ShellContent ContentTemplate="{DataTemplate worker:NotificationsPage}" Route="WorkerNotificationsContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="WorkerPerformanceItem" Title="Performance" Route="WorkerPerformance">
        <ShellContent ContentTemplate="{DataTemplate worker:ProfilePage}" Route="WorkerPerformanceContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="WorkerProfileItem" Title="Worker Profile" Route="WorkerProfile">
        <ShellContent ContentTemplate="{DataTemplate worker:ProfilePage}" Route="WorkerProfileContent" />
    </FlyoutItem>
    <FlyoutItem x:Name="WorkerSettingsItem" Title="Worker Settings" Route="WorkerSettings">
        <ShellContent ContentTemplate="{DataTemplate worker:SettingsPage}" Route="WorkerSettingsContent" />
    </FlyoutItem>

</Shell>
