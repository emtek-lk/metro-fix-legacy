@inherits LayoutComponentBase
@implements IDisposable
@inject GTEK.FSM.WebPortal.Services.Theme.ThemeState ThemeState
@inject GTEK.FSM.WebPortal.Services.Security.PortalAuthState AuthState
@inject NavigationManager Navigation

<div class="@PageCssClass">
    <header class="top-bar px-4">
        <div class="portal-brand">
            <div class="portal-brand__logo" aria-hidden="true">GF</div>
            <div class="portal-header">
                <strong>GTEK FSM</strong>
                <span class="portal-subtitle">@HeaderSubtitle</span>
            </div>
        </div>
        <div class="portal-tenant-pill">@TenantPillLabel</div>
        <div class="top-bar-actions">
            <div class="portal-user-pill" title="@AuthState.Session?.DisplayName (@AuthState.CurrentRole)">
                <span class="portal-user-avatar" aria-hidden="true">@UserInitials</span>
                <span class="portal-user-name">@AuthState.Session?.DisplayName</span>
                <span class="portal-user-role">@AuthState.CurrentRole</span>
            </div>
            <button class="theme-toggle btn-icon-theme" @onclick="ToggleThemeAsync"
                    aria-label="@(ThemeState.CurrentMode == GTEK.FSM.WebPortal.Services.Theme.ThemeMode.Dark ? "Switch to light mode" : "Switch to dark mode")"
                    title="@(ThemeState.CurrentMode == GTEK.FSM.WebPortal.Services.Theme.ThemeMode.Dark ? "Switch to light mode" : "Switch to dark mode")">
                @if (ThemeState.CurrentMode == GTEK.FSM.WebPortal.Services.Theme.ThemeMode.Dark)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                    </svg>
                }
            </button>
            <button class="theme-toggle theme-toggle--danger" @onclick="LogoutAsync" aria-label="Sign out">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Sign out
            </button>
        </div>
    </header>

    <aside class="side-nav">
        <NavMenu IsSidebarCollapsed="@isSidebarCollapsed" OnToggleSidebar="@ToggleSidebar" />
    </aside>

    <main class="content-area">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>


@code {
    private bool _initialized;
    private bool isSidebarCollapsed;

    private string PageCssClass => isSidebarCollapsed ? "page page--nav-compact" : "page";

    private string UserInitials
    {
        get
        {
            var name = AuthState.Session?.DisplayName ?? string.Empty;
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
            if (parts.Length == 1 && parts[0].Length >= 1) return parts[0][0].ToString().ToUpperInvariant();
            return "U";
        }
    }

    private string HeaderSubtitle => string.IsNullOrWhiteSpace(AuthState.CurrentTenantId)
        ? "Customer Care & Management"
        : $"Tenant {AuthState.CurrentTenantId}";

    private string TenantPillLabel => string.IsNullOrWhiteSpace(AuthState.CurrentTenantId)
        ? "No tenant"
        : $"Tenant {AuthState.CurrentTenantId}";


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await ThemeState.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeState.ToggleAsync();
    }

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private async Task LogoutAsync()
    {
        await AuthState.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
    }
}
