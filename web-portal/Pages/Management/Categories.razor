@page "/management/categories"
@using GTEK.FSM.Shared.Contracts.Api.Contracts.Categories.Requests
@using GTEK.FSM.Shared.Contracts.Api.Contracts.Categories.Responses
@using GTEK.FSM.WebPortal.Services.Management
@inject IManagementCategoriesApiClient CategoriesApiClient

<PageTitle>Management Categories</PageTitle>

<section class="portal-page-shell">
<PortalSectionHeader
	Title="Management Categories"
	Description="Category catalog controls, ordering rules, and enablement management.">
	<Actions>
			<div class="portal-inline-actions">
				<label class="toggle-switch" style="font-size:var(--font-size-sm)">
					<input type="checkbox" @bind="IncludeDisabled" /> Include disabled
				</label>
				<button class="btn btn-secondary btn-sm" @onclick="ReloadAsync" disabled="@IsLoading">Refresh Data</button>
				<button class="btn btn-primary btn-sm" @onclick="SaveReorderAsync" disabled="@(!HasPendingReorder || IsSaving)">Save Order</button>
			</div>
	</Actions>
</PortalSectionHeader>

@if (!string.IsNullOrWhiteSpace(Notice))
{
	<div class="notice-banner notice-banner-success" role="alert">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
		@Notice
	</div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
	<div class="notice-banner notice-banner-error" role="alert">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
		@ErrorMessage
	</div>
}

<section class="categories-layout portal-grid-2">
	<article class="categories-panel portal-panel">
		<h2>@(EditTarget is null ? "Create Category" : "Edit Category")</h2>
			<div class="portal-form-grid">
				<div class="form-field">
					<label for="cat-code">Category Code</label>
					<input id="cat-code" @bind="Form.Code" placeholder="e.g. ELEC" />
				</div>
				<div class="form-field">
					<label for="cat-name">Name</label>
					<input id="cat-name" @bind="Form.Name" placeholder="Category name" />
				</div>
				<div class="form-field">
					<label for="cat-sort">Sort Order</label>
					<input id="cat-sort" type="number" min="0" max="999" step="1" @bind="Form.SortOrder" />
				</div>
				<label class="toggle-switch">
					<input type="checkbox" @bind="Form.IsEnabled" /> Enabled
				</label>
				<div class="portal-inline-actions" style="margin-top:var(--space-2)">
					<button class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">@(EditTarget is null ? "Add Category" : "Save Changes")</button>
					@if (EditTarget is not null)
					{
						<button class="btn btn-ghost" @onclick="CancelEdit" disabled="@IsSaving">Cancel</button>
					}
				</div>
			</div>
	</article>

	<article class="categories-panel portal-panel">
		<h2>Category Catalog</h2>
		@if (IsLoading)
		{
			<p>Loading categories...</p>
		}
		else if (CategoryItems.Count == 0)
		{
			<p>No categories found for current filters.</p>
		}
		else
		{
			<table class="categories-table">
				<thead>
					<tr>
						<th>Order</th>
						<th>Code</th>
						<th>Name</th>
						<th>Enabled</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@for (var i = 0; i < CategoryItems.Count; i++)
					{
						var category = CategoryItems[i];
						<tr>
							<td>@category.SortOrder</td>
							<td><span class="mono">@category.Code</span></td>
							<td>@category.Name</td>
							<td>@if (category.IsEnabled) { <span class="badge badge-success">Yes</span> } else { <span class="badge badge-neutral">No</span> }</td>
							<td class="portal-inline-actions">
								<button class="btn btn-ghost btn-sm" @onclick="() => MoveUp(i)" disabled="@(i == 0 || IsSaving)" title="Move up">↑</button>
								<button class="btn btn-ghost btn-sm" @onclick="() => MoveDown(i)" disabled="@(i == CategoryItems.Count - 1 || IsSaving)" title="Move down">↓</button>
								<button class="btn btn-secondary btn-sm" @onclick="() => BeginEdit(category)" disabled="@IsSaving">Edit</button>
								@if (category.IsEnabled)
								{
									<button class="btn btn-danger btn-sm" @onclick="() => DisableAsync(category)" disabled="@IsSaving">Disable</button>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</article>
</section>
</section>



@code {
	private readonly CategoryEditorModel Form = new();

	private List<CategoryResponse> CategoryItems { get; set; } = [];

	private CategoryResponse? EditTarget { get; set; }

	private bool IncludeDisabled { get; set; }

	private bool IsLoading { get; set; }

	private bool IsSaving { get; set; }

	private bool HasPendingReorder { get; set; }

	private string? ErrorMessage { get; set; }

	private string? Notice { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await this.ReloadAsync();
	}

	private async Task ReloadAsync()
	{
		this.IsLoading = true;
		this.ErrorMessage = null;
		this.Notice = null;

		try
		{
			this.CategoryItems = (await this.CategoriesApiClient.ListAsync(this.IncludeDisabled))
				.OrderBy(x => x.SortOrder)
				.ThenBy(x => x.Code, StringComparer.OrdinalIgnoreCase)
				.ToList();
			this.HasPendingReorder = false;
		}
		catch (ManagementCategoriesApiException ex)
		{
			this.ErrorMessage = ex.Message;
		}
		finally
		{
			this.IsLoading = false;
		}
	}

	private async Task SaveAsync()
	{
		this.IsSaving = true;
		this.ErrorMessage = null;
		this.Notice = null;

		try
		{
			if (this.EditTarget is null)
			{
				await this.CategoriesApiClient.CreateAsync(new CreateCategoryRequest
				{
					Code = this.Form.Code,
					Name = this.Form.Name,
					SortOrder = this.Form.SortOrder,
				});
				this.Notice = "Category created.";
			}
			else
			{
				await this.CategoriesApiClient.UpdateAsync(this.EditTarget.CategoryId ?? string.Empty, new UpdateCategoryRequest
				{
					Code = this.Form.Code,
					Name = this.Form.Name,
					SortOrder = this.Form.SortOrder,
					IsEnabled = this.Form.IsEnabled,
				});
				this.Notice = "Category updated.";
			}

			this.EditTarget = null;
			this.Form.Reset();
			await this.ReloadAsync();
		}
		catch (ManagementCategoriesApiException ex)
		{
			this.ErrorMessage = ex.Message;
		}
		finally
		{
			this.IsSaving = false;
		}
	}

	private async Task DisableAsync(CategoryResponse category)
	{
		this.IsSaving = true;
		this.ErrorMessage = null;
		this.Notice = null;

		try
		{
			await this.CategoriesApiClient.DisableAsync(category.CategoryId ?? string.Empty);
			this.Notice = "Category disabled.";
			await this.ReloadAsync();
		}
		catch (ManagementCategoriesApiException ex)
		{
			this.ErrorMessage = ex.Message;
		}
		finally
		{
			this.IsSaving = false;
		}
	}

	private void BeginEdit(CategoryResponse category)
	{
		this.EditTarget = category;
		this.Form.Code = category.Code ?? string.Empty;
		this.Form.Name = category.Name ?? string.Empty;
		this.Form.SortOrder = category.SortOrder;
		this.Form.IsEnabled = category.IsEnabled;
		this.ErrorMessage = null;
		this.Notice = null;
	}

	private void CancelEdit()
	{
		this.EditTarget = null;
		this.Form.Reset();
		this.ErrorMessage = null;
	}

	private void MoveUp(int index)
	{
		if (index <= 0)
		{
			return;
		}

		(this.CategoryItems[index - 1], this.CategoryItems[index]) = (this.CategoryItems[index], this.CategoryItems[index - 1]);
		RecalculateSortOrder();
	}

	private void MoveDown(int index)
	{
		if (index >= this.CategoryItems.Count - 1)
		{
			return;
		}

		(this.CategoryItems[index + 1], this.CategoryItems[index]) = (this.CategoryItems[index], this.CategoryItems[index + 1]);
		RecalculateSortOrder();
	}

	private async Task SaveReorderAsync()
	{
		this.IsSaving = true;
		this.ErrorMessage = null;
		this.Notice = null;

		try
		{
			this.CategoryItems = (await this.CategoriesApiClient.ReorderAsync(new ReorderCategoriesRequest
			{
				Items = this.CategoryItems
					.Select(x => new ReorderCategoryItemRequest
					{
						CategoryId = x.CategoryId,
						SortOrder = x.SortOrder,
					})
					.ToArray(),
			}))
				.OrderBy(x => x.SortOrder)
				.ThenBy(x => x.Code, StringComparer.OrdinalIgnoreCase)
				.ToList();

			this.HasPendingReorder = false;
			this.Notice = "Category order updated.";
		}
		catch (ManagementCategoriesApiException ex)
		{
			this.ErrorMessage = ex.Message;
		}
		finally
		{
			this.IsSaving = false;
		}
	}

	private void RecalculateSortOrder()
	{
		for (var i = 0; i < this.CategoryItems.Count; i++)
		{
			this.CategoryItems[i].SortOrder = i;
		}

		this.HasPendingReorder = true;
	}

	private sealed class CategoryEditorModel
	{
		public string Code { get; set; } = string.Empty;

		public string Name { get; set; } = string.Empty;

		public int SortOrder { get; set; }

		public bool IsEnabled { get; set; } = true;

		public void Reset()
		{
			this.Code = string.Empty;
			this.Name = string.Empty;
			this.SortOrder = 0;
			this.IsEnabled = true;
		}
	}
}
