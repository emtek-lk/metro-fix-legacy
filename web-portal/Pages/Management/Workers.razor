@page "/management/workers"
@using GTEK.FSM.Shared.Contracts.Api.Contracts.Workers.Requests
@using GTEK.FSM.Shared.Contracts.Api.Contracts.Workers.Responses
@using GTEK.FSM.WebPortal.Services.Management
@inject IManagementWorkersApiClient WorkersApiClient

<PageTitle>Management Workers</PageTitle>

<section class="portal-page-shell">
	<PortalSectionHeader
	Title="Workforce"
	Description="Worker profile management, availability controls, and skills governance.">
		<Actions>
			<div class="portal-inline-actions">
				<input class="ops-filter-input" style="min-width:220px" @bind="SearchText" placeholder="Search by name or code…" aria-label="Search workers" />
				<label class="toggle-switch" style="font-size:var(--font-size-sm);gap:var(--space-2)">
					<input type="checkbox" @bind="IncludeInactive" /> Include inactive
				</label>
				<button class="btn btn-secondary btn-sm" @onclick="ReloadAsync" disabled="@IsLoading">Refresh Data</button>
			</div>
		</Actions>
	</PortalSectionHeader>

@if (!string.IsNullOrWhiteSpace(Notice))
{
	<div class="notice-banner notice-banner-success" role="alert">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
		@Notice
	</div>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
	<div class="notice-banner notice-banner-error" role="alert">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
		@ErrorMessage
	</div>
}

<section class="workers-layout portal-grid-2">
	<article class="workers-panel portal-panel" style="align-self:start">
		<h2>@(EditTarget is null ? "Add Worker" : "Edit Worker")</h2>
		<div class="portal-form-grid">
			<div class="form-field">
				<label for="wf-code">Worker Code</label>
				<input id="wf-code" @bind="Form.WorkerCode" placeholder="e.g. WRK-001" />
			</div>
			<div class="form-field">
				<label for="wf-name">Display Name</label>
				<input id="wf-name" @bind="Form.DisplayName" placeholder="Full name" />
			</div>
			<div class="form-field">
				<label for="wf-rating">Performance Rating</label>
				<input id="wf-rating" type="number" min="1" max="5" step="0.1" @bind="Form.InternalRating" />
				<p class="field-hint">Rate from 1.0 (needs improvement) to 5.0 (excellent)</p>
			</div>
			<div class="form-field">
				<label for="wf-avail">Availability</label>
				<select id="wf-avail" @bind="Form.AvailabilityStatus">
					@foreach (var value in AvailabilityOptions)
					{
						<option value="@value">@value</option>
					}
				</select>
			</div>
			<div class="form-field">
				<label for="wf-skills">Skills</label>
				<input id="wf-skills" @bind="Form.SkillsCsv" placeholder="e.g. Plumbing, Electrical, HVAC" />
				<p class="field-hint">Separate multiple skills with commas</p>
			</div>
			<label class="toggle-switch">
				<input type="checkbox" @bind="Form.IsActive" /> Active profile
			</label>
			<div class="portal-inline-actions" style="margin-top:var(--space-2)">
				<button class="btn btn-primary" @onclick="SaveAsync" disabled="@IsSaving">@(EditTarget is null ? "Add Worker" : "Save Changes")</button>
				@if (EditTarget is not null)
				{
					<button class="btn btn-ghost" @onclick="CancelEdit">Cancel</button>
				}
			</div>
		</div>
	</article>

	<article class="workers-panel portal-panel">
		<h2>Worker Profiles</h2>
		@if (IsLoading)
		{
			<div class="skeleton skeleton-row"></div>
			<div class="skeleton skeleton-row"></div>
			<div class="skeleton skeleton-row"></div>
		}
		else if (WorkerItems.Count == 0)
		{
			<div class="empty-state">
				<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>
				<p><strong>No workers found</strong>No workers match the current filters. Try adjusting your search or include inactive profiles.</p>
			</div>
		}
		else
		{
			<div class="audit-table-wrap">
			<table class="portal-table">
				<thead>
					<tr>
						<th>Code</th>
						<th>Name</th>
						<th>Rating</th>
						<th>Availability</th>
						<th>Skills</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var worker in WorkerItems)
					{
						<tr>
							<td><span class="mono">@worker.WorkerCode</span></td>
							<td>@worker.DisplayName</td>
							<td>@worker.InternalRating.ToString("0.0")</td>
							<td>@worker.AvailabilityStatus</td>
							<td style="max-width:180px;white-space:normal">@string.Join(", ", worker.Skills)</td>
							<td>
								@if (worker.IsActive)
								{
									<span class="badge badge-success">Active</span>
								}
								else
								{
									<span class="badge badge-neutral">Inactive</span>
								}
							</td>
							<td>
								<button class="btn btn-secondary btn-sm" @onclick="() => BeginEdit(worker)">Edit</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
		}
	</article>
</section>
</section>



@code {
	private static readonly string[] AvailabilityOptions = ["Available", "Busy", "OnBreak", "Unavailable", "Offline"];

	private readonly WorkerEditorModel Form = new();
	private List<WorkerProfileResponse> WorkerItems { get; set; } = [];

	private WorkerProfileResponse? EditTarget { get; set; }

	private string? SearchText { get; set; }

	private bool IncludeInactive { get; set; }

	private bool IsLoading { get; set; }

	private bool IsSaving { get; set; }

	private string? ErrorMessage { get; set; }

	private string? Notice { get; set; }

	protected override async Task OnInitializedAsync()
	{
		await this.ReloadAsync();
	}

	private async Task ReloadAsync()
	{
		this.IsLoading = true;
		this.ErrorMessage = null;
		this.Notice = null;

		try
		{
			this.WorkerItems = (await this.WorkersApiClient.ListAsync(this.SearchText, this.IncludeInactive)).ToList();
		}
		catch (ManagementWorkersApiException ex)
		{
			this.ErrorMessage = ex.Message;
		}
		finally
		{
			this.IsLoading = false;
		}
	}

	private async Task SaveAsync()
	{
		this.IsSaving = true;
		this.ErrorMessage = null;
		this.Notice = null;

		try
		{
			if (this.EditTarget is null)
			{
				await this.WorkersApiClient.CreateAsync(new CreateWorkerProfileRequest
				{
					WorkerCode = this.Form.WorkerCode,
					DisplayName = this.Form.DisplayName,
					InternalRating = this.Form.InternalRating,
					AvailabilityStatus = this.Form.AvailabilityStatus,
					IsActive = this.Form.IsActive,
					Skills = ParseSkills(this.Form.SkillsCsv),
				});

				this.Notice = "Worker profile created.";
			}
			else
			{
				await this.WorkersApiClient.UpdateAsync(this.EditTarget.WorkerId ?? string.Empty, new UpdateWorkerProfileRequest
				{
					WorkerCode = this.Form.WorkerCode,
					DisplayName = this.Form.DisplayName,
					InternalRating = this.Form.InternalRating,
					AvailabilityStatus = this.Form.AvailabilityStatus,
					IsActive = this.Form.IsActive,
					Skills = ParseSkills(this.Form.SkillsCsv),
				});

				this.Notice = "Worker profile updated.";
			}

			this.CancelEdit();
			await this.ReloadAsync();
		}
		catch (ManagementWorkersApiException ex)
		{
			this.ErrorMessage = ex.Message;
		}
		finally
		{
			this.IsSaving = false;
		}
	}

	private void BeginEdit(WorkerProfileResponse worker)
	{
		this.EditTarget = worker;
		this.Form.WorkerCode = worker.WorkerCode;
		this.Form.DisplayName = worker.DisplayName;
		this.Form.InternalRating = worker.InternalRating;
		this.Form.AvailabilityStatus = worker.AvailabilityStatus;
		this.Form.IsActive = worker.IsActive;
		this.Form.SkillsCsv = string.Join(", ", worker.Skills);
	}

	private void CancelEdit()
	{
		this.EditTarget = null;
		this.Form.WorkerCode = string.Empty;
		this.Form.DisplayName = string.Empty;
		this.Form.InternalRating = 3.0m;
		this.Form.AvailabilityStatus = "Available";
		this.Form.IsActive = true;
		this.Form.SkillsCsv = string.Empty;
	}

	private static string[] ParseSkills(string? skillsCsv)
	{
		return (skillsCsv ?? string.Empty)
			.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
			.Where(x => !string.IsNullOrWhiteSpace(x))
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.ToArray();
	}

	private sealed class WorkerEditorModel
	{
		public string? WorkerCode { get; set; }

		public string? DisplayName { get; set; }

		public decimal InternalRating { get; set; } = 3.0m;

		public string? AvailabilityStatus { get; set; } = "Available";

		public bool IsActive { get; set; } = true;

		public string? SkillsCsv { get; set; }
	}
}
