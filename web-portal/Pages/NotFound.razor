@page "/not-found"
@inject NavigationManager Navigation

<PageTitle>404 — Page Not Found</PageTitle>

<div class="not-found-page">
    <div class="not-found-inner">
        <p class="not-found-code">404</p>
        <h1 class="not-found-title">Page not found</h1>
        <p class="not-found-desc">The page you're looking for doesn't exist or has been moved. Check the URL or navigate back to the dashboard.</p>
        <button class="btn btn-primary btn-lg" @onclick='() => Navigation.NavigateTo("/")'>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Back to Dashboard
        </button>
    </div>
</div>

<style>
.not-found-page {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
}
.not-found-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 480px;
}
.not-found-code {
    font-size: 7rem;
    font-weight: 800;
    line-height: 1;
    margin: 0;
    background: linear-gradient(135deg, var(--color-link-default), color-mix(in srgb, var(--color-link-default) 50%, #3b82f6));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
}
.not-found-title {
    font-size: 1.6rem;
    font-weight: var(--font-weight-bold);
    margin: 0;
    color: var(--color-text-primary);
}
.not-found-desc {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    margin: 0;
}
</style>