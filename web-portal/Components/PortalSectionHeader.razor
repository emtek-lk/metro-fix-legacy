@namespace GTEK.FSM.WebPortal.Components

<header class="psh" aria-label="@Title">
    <div class="psh__copy">
        <h1 class="psh__title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="psh__desc">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="psh__actions" role="toolbar" aria-label="@($"{Title} actions")">
            @Actions
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public string? Description { get; set; }
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
