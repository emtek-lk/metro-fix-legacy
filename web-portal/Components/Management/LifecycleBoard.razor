@namespace GTEK.FSM.WebPortal.Components.Management
@using GTEK.FSM.WebPortal.Models

<section class="lifecycle-board"
         role="region"
         aria-label="Request lifecycle transition board"
         tabindex="0">
    <div class="lifecycle-board__grid" role="list" aria-label="Lifecycle status columns">
        @foreach (var column in Columns)
        {
            <LifecycleColumn Column="column" Disabled="Disabled" OnToggle="OnToggle" />
        }
    </div>
</section>

@code {
    [Parameter]
    public IReadOnlyList<LifecycleColumnModel> Columns { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<LifecycleTransitionCardModel> OnToggle { get; set; }
}
