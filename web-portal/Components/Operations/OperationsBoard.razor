<section class="ops-board">
    <div class="ops-board__header">
        <div class="ops-board__title-group">
            <h2 class="ops-board__title">@Title</h2>
            <p class="ops-board__subtitle">@Subtitle</p>
        </div>
        <div class="ops-board__controls">
            <div class="ops-filter-group">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input class="ops-filter-input"
                       placeholder="Search cards…"
                       @bind="searchText"
                       @bind:event="oninput"
                       aria-label="Filter board cards" />
            </div>
            <select class="ops-filter-select" @bind="priorityFilter" aria-label="Filter by priority">
                @foreach (var option in PriorityOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
    </div>

    <div class="ops-board__lane-wrap">
        @foreach (var lane in FilteredColumns)
        {
            <section class="ops-lane" @key="lane.Name">
                <header class="ops-lane__header">
                    <span class="ops-lane__name">@lane.Name</span>
                    <span class="ops-lane__count">@lane.Cards.Count</span>
                </header>

                <div class="ops-lane__cards">
                    @if (lane.Cards.Count == 0)
                    {
                        <div class="ops-lane__empty">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                            <span>No cards</span>
                        </div>
                    }
                    @foreach (var card in lane.Cards)
                    {
                        <article class="ops-card ops-card--@card.Priority.ToLowerInvariant()" @key="card.RequestId">
                            <div class="ops-card__top">
                                <span class="ops-card__ref mono">@card.Reference</span>
                                <span class="priority-chip priority-@card.Priority.ToLowerInvariant()">@card.Priority</span>
                            </div>
                            <h3 class="ops-card__title">@card.Title</h3>
                            <div class="ops-card__footer">
                                <div class="ops-card__assignee">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <span>@card.Assignee</span>
                                </div>
                                <span class="ops-card__time">@FormatAge(card.UpdatedAtUtc)</span>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
</section>

@code {
    private string searchText = string.Empty;
    private string priorityFilter = "All";

    [Parameter]
    public string Title { get; set; } = "Operations Board";

    [Parameter]
    public string Subtitle { get; set; } = "Stage-based coordination view";

    [Parameter]
    public IReadOnlyList<OperationsBoardColumn> Columns { get; set; } = [];

    private IReadOnlyList<string> PriorityOptions =>
        ["All", .. Columns.SelectMany(x => x.Cards).Select(x => x.Priority).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x)];

    private IReadOnlyList<OperationsBoardColumn> FilteredColumns =>
        Columns
            .Select(column => new OperationsBoardColumn(
                column.Name,
                column.Cards
                    .Where(card => priorityFilter == "All" || string.Equals(card.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase))
                    .Where(card => string.IsNullOrWhiteSpace(searchText)
                        || card.Reference.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || card.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                        || card.Assignee.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(card => card.UpdatedAtUtc)
                    .ToList()))
            .ToList();

    private static string FormatAge(DateTime updatedAt)
    {
        var diff = DateTime.UtcNow - updatedAt;
        if (diff.TotalHours >= 1) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalMinutes}m ago";
    }
}
