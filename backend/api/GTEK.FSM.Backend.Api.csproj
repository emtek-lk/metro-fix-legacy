    <Compile Include="Middleware/TenantResolutionMiddleware.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Realtime/OperationsHub.cs" />
    <Compile Include="Realtime/OperationsHubGroups.cs" />
    <Compile Include="Realtime/SignalROperationalUpdatePublisher.cs" />
    <Compile Include="Routing/ApiRouteConstants.cs" />
